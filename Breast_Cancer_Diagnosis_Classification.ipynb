      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "from sklearn.datasets import load_breast_cancer\n",
        "\n",
        "print(\"Libraries imported successfully!\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 2,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "G4UnFZyamGQY",
        "outputId": "a8988160-2695-443d-8fbe-1003f6af3470"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Dataset shape: (569, 30)\n",
            "\n",
            "Target distribution:\n",
            "target\n",
            "1    357\n",
            "0    212\n",
            "Name: count, dtype: int64\n",
            "(0 = malignant, 1 = benign)\n"
          ]
        }
      ],
      "source": [
        "data = load_breast_cancer()\n",
        "X = pd.DataFrame(data.data, columns=data.feature_names)\n",
        "y = pd.Series(data.target, name=\"target\")  # 0 = malignant, 1 = benign\n",
        "\n",
        "print(\"Dataset shape:\", X.shape)\n",
        "print(\"\\nTarget distribution:\")\n",
        "print(y.value_counts())\n",
        "print(\"(0 = malignant, 1 = benign)\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"\\nMissing values:\", X.isnull().sum().sum())\n",
        "print(\"Duplicate rows:\", X.duplicated().sum())\n",
        "print(\"Negative values:\", (X < 0).sum().sum())\n",
        "print(\"All three checks came back clean — verified programmatically, not assumed.\")\n",
        ""
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "cQuU6cZgmcaH",
        "outputId": "f84b5552-a1ab-4a34-b513-70a899730175"
      },
      "execution_count": 6,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "\n",
            "Missing values: 0\n",
            "Duplicate rows: 0\n",
            "Negative values: 0\n",
            "All three checks came back clean — verified programmatically, not assumed.\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "correlation_matrix = X.corr()\n",
        "high_corr_pairs = []\n",
        "for i in range(len(correlation_matrix.columns)):\n",
        "    for j in range(i + 1, len(correlation_matrix.columns)):\n",
        "        corr = correlation_matrix.iloc[i, j]\n",
        "        if corr > 0.95:\n",
        "            high_corr_pairs.append(\n",
        "                (correlation_matrix.columns[i], correlation_matrix.columns[j], corr)\n",
        "            )\n",
        "\n",
        "print(f\"\\nFeature pairs with correlation > 0.95: {len(high_corr_pairs)}\")\n",
        "for a, b, c in high_corr_pairs[:5]:\n",
        "    print(f\"  {a} <-> {b}: {c:.3f}\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "6-VWt7GjnN40",
        "outputId": "5e931e10-6ecf-40cc-eda9-d77dad66cb75"
      },
      "execution_count": 7,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "\n",
            "Feature pairs with correlation > 0.95: 15\n",
            "  mean radius <-> mean perimeter: 0.998\n",
            "  mean radius <-> mean area: 0.987\n",
            "  mean radius <-> worst radius: 0.970\n",
            "  mean radius <-> worst perimeter: 0.965\n",
            "  mean perimeter <-> mean area: 0.987\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "cols_to_drop = sorted({b for _, b, _ in high_corr_pairs})\n",
        "print(f\"\\nDropping {len(cols_to_drop)} redundant columns for the linear model:\")\n",
        "print(cols_to_drop)\n",
        "\n",
        "X_reduced = X.drop(columns=cols_to_drop)\n",
        "print(f\"Reduced feature set: {X.shape[1]} -> {X_reduced.shape[1]} columns\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "pUkoiopCnQ5l",
        "outputId": "c138f114-0b18-4ae3-b09d-cbeb92b4b92f"
      },
      "execution_count": 8,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "\n",
            "Dropping 7 redundant columns for the linear model:\n",
            "['area error', 'mean area', 'mean perimeter', 'perimeter error', 'worst area', 'worst perimeter', 'worst radius']\n",
            "Reduced feature set: 30 -> 23 columns\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "X[\"mean_compactness_ratio\"] = (X[\"mean perimeter\"] ** 2) / X[\"mean area\"]\n",
        "X_reduced[\"mean_compactness_ratio\"] = X[\"mean_compactness_ratio\"]\n",
        "print(\"\\nEngineered feature 'mean_compactness_ratio' added \"\n",
        "      \"(perimeter^2 / area — higher = more irregular shape).\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "VA8jUOwGna0G",
        "outputId": "95d3661c-bda7-4ac7-f1f9-c7940509f40e"
      },
      "execution_count": 9,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "\n",
            "Engineered feature 'mean_compactness_ratio' added (perimeter^2 / area — higher = more irregular shape).\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "RANDOM_STATE = 42\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X_reduced, y, test_size=0.20, random_state=RANDOM_STATE, stratify=y\n",
        ")\n",
        "\n",
        "X_train_full, X_test_full = X.loc[X_train.index], X.loc[X_test.index]\n",
        "\n",
        "print(f\"\\nTrain size: {len(X_train)}, Test size: {len(X_test)}\")\n",
        "print(\"Train class balance:\\n\", y_train.value_counts(normalize=True).round(3))\n",
        "print(\"Test class balance:\\n\", y_test.value_counts(normalize=True).round(3))\n",
        "\n",
        "scaler = StandardScaler()\n",
        "X_train_scaled = scaler.fit_transform(X_train)\n",
        "X_test_scaled = scaler.transform(X_test)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "iJmNdmS_nqc-",
        "outputId": "59a90883-edfc-4aab-8c5c-f7a94a14e56a"
      },
      "execution_count": 13,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "\n",
            "Train size: 455, Test size: 114\n",
            "Train class balance:\n",
            " target\n",
            "1    0.626\n",
            "0    0.374\n",
            "Name: proportion, dtype: float64\n",
            "Test class balance:\n",
            " target\n",
            "1    0.632\n",
            "0    0.368\n",
            "Name: proportion, dtype: float64\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "from sklearn.dummy import DummyClassifier\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score, precision_score, recall_score, f1_score,\n",
        "    roc_auc_score, confusion_matrix, ConfusionMatrixDisplay,\n",
        "    classification_report\n",
        ")\n",
        "\n",
        "baseline_model = DummyClassifier(strategy=\"most_frequent\", random_state=RANDOM_STATE)\n",
        "baseline_model.fit(X_train_scaled, y_train)\n",
        "baseline_pred = baseline_model.predict(X_test_scaled)\n",
        "\n",
        "baseline_accuracy = accuracy_score(y_test, baseline_pred)\n",
        "baseline_precision = precision_score(y_test, baseline_pred, zero_division=0)\n",
        "baseline_recall = recall_score(y_test, baseline_pred)\n",
        "baseline_f1 = f1_score(y_test, baseline_pred)\n",
        "\n",
        "print(\"\\nBaseline Results (always predicts majority class)\")\n",
        "print(\"Accuracy :\", round(baseline_accuracy, 3))\n",
        "print(\"Precision:\", round(baseline_precision, 3))\n",
        "print(\"Recall   :\", round(baseline_recall, 3))\n",
        "print(\"F1 Score :\", round(baseline_f1, 3))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "9Ejpvg_IoFuH",
        "outputId": "f5e9bfbe-c207-4ac9-9762-74760d907fed"
      },
      "execution_count": 14,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "\n",
            "Baseline Results (always predicts majority class)\n",
            "Accuracy : 0.632\n",
            "Precision: 0.632\n",
            "Recall   : 1.0\n",
            "F1 Score : 0.774\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "from sklearn.linear_model import LogisticRegression\n",
        "\n",
        "logistic_model = LogisticRegression(max_iter=1000, random_state=RANDOM_STATE)\n",
        "logistic_model.fit(X_train_scaled, y_train)\n",
        "logistic_pred = logistic_model.predict(X_test_scaled)\n",
        "logistic_prob = logistic_model.predict_proba(X_test_scaled)[:, 1]\n",
        "\n",
        "logistic_accuracy = accuracy_score(y_test, logistic_pred)\n",
        "logistic_precision = precision_score(y_test, logistic_pred)\n",
        "logistic_recall = recall_score(y_test, logistic_pred)\n",
        "logistic_f1 = f1_score(y_test, logistic_pred)\n",
        "logistic_roc_auc = roc_auc_score(y_test, logistic_prob)\n",
        "\n",
        "print(\"\\nLogistic Regression Results\")\n",
        "print(\"Accuracy :\", round(logistic_accuracy, 3))\n",
        "print(\"Precision:\", round(logistic_precision, 3))\n",
        "print(\"Recall   :\", round(logistic_recall, 3))\n",
        "print(\"F1 Score :\", round(logistic_f1, 3))\n",
        "print(\"ROC-AUC  :\", round(logistic_roc_auc, 3))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "rNLylIRDoTV9",
        "outputId": "30b8011c-1696-411b-ab80-1d257be20a79"
      },
      "execution_count": 15,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "\n",
            "Logistic Regression Results\n",
            "Accuracy : 0.974\n",
            "Precision: 0.986\n",
            "Recall   : 0.972\n",
            "F1 Score : 0.979\n",
            "ROC-AUC  : 0.993\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "from sklearn.ensemble import RandomForestClassifier\n",
        "rf_model = RandomForestClassifier(n_estimators=300, max_depth=6, random_state=RANDOM_STATE)\n",
        "rf_model.fit(X_train_full, y_train)\n",
        "rf_pred = rf_model.predict(X_test_full)\n",
        "rf_prob = rf_model.predict_proba(X_test_full)[:, 1]\n",
        "\n",
        "rf_accuracy = accuracy_score(y_test, rf_pred)\n",
        "rf_precision = precision_score(y_test, rf_pred)\n",
        "rf_recall = recall_score(y_test, rf_pred)\n",
        "rf_f1 = f1_score(y_test, rf_pred)\n",
        "rf_roc_auc = roc_auc_score(y_test, rf_prob)\n",
        "\n",
        "print(\"\\nRandom Forest Results\")\n",
        "print(\"Accuracy :\", round(rf_accuracy, 3))\n",
        "print(\"Precision:\", round(rf_precision, 3))\n",
        "print(\"Recall   :\", round(rf_recall, 3))\n",
        "print(\"F1 Score :\", round(rf_f1, 3))\n",
        "print(\"ROC-AUC  :\", round(rf_roc_auc, 3))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "1m3pVFbPoeRz",
        "outputId": "95dae8f8-852b-49ad-b94a-a5f5760c5fc1"
      },
      "execution_count": 16,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "\n",
            "Random Forest Results\n",
            "Accuracy : 0.956\n",
            "Precision: 0.959\n",
            "Recall   : 0.972\n",
            "F1 Score : 0.966\n",
            "ROC-AUC  : 0.992\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "results = pd.DataFrame({\n",
        "    \"Model\": [\"Baseline\", \"Logistic Regression\", \"Random Forest\"],\n",
        "    \"Accuracy\": [baseline_accuracy, logistic_accuracy, rf_accuracy],\n",
        "    \"Precision\": [baseline_precision, logistic_precision, rf_precision],\n",
        "    \"Recall\": [baseline_recall, logistic_recall, rf_recall],\n",
        "    \"F1 Score\": [baseline_f1, logistic_f1, rf_f1],\n",
        "    \"ROC-AUC\": [np.nan, logistic_roc_auc, rf_roc_auc],\n",
        "}).set_index(\"Model\")\n",
        "\n",
        "print(\"\\nModel Comparison:\")\n",
        "print(results.round(3))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
